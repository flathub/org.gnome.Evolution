From 47c1a9b50eb1a43adb9efae242412191b3d64255 Mon Sep 17 00:00:00 2001
Date: Tue, 28 Apr 2026 18:33:08 +0200
Subject: [PATCH] OAuth2: Use its own error domain

Update EWS and M365 connection code to check for the new
E_OAUTH2_SERVICE_ERROR_TOKEN_EXPIRED and
E_OAUTH2_SERVICE_ERROR_REFRESH_FAILED codes instead of
G_IO_ERROR_CONNECTION_REFUSED when detecting OAuth2 token
failures. The E_SOUP_SESSION_ERROR checks for direct endpoint
401 errors are kept alongside the new checks.

Related: https://github.com/flathub/org.gnome.Evolution/issues/222

Assisted-by: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 src/EWS/common/e-ews-connection.c           | 4 ++--
 src/Microsoft365/common/e-m365-connection.c | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/EWS/common/e-ews-connection.c b/src/EWS/common/e-ews-connection.c
index 5146839d..9936c257 100644
--- a/src/EWS/common/e-ews-connection.c
+++ b/src/EWS/common/e-ews-connection.c
@@ -436,8 +436,8 @@ e_ews_connection_process_request_sync (EEwsConnection *cnc,
 
 	if (!pd.prepare_data) {
 		if (error && (g_error_matches (*error, E_SOUP_SESSION_ERROR, SOUP_STATUS_UNAUTHORIZED) ||
-			      /* Returned by the OAuth2 service when the token cannot be refreshed */
-			      g_error_matches (*error, G_IO_ERROR, G_IO_ERROR_CONNECTION_REFUSED))) {
+			      g_error_matches (*error, E_OAUTH2_SERVICE_ERROR, E_OAUTH2_SERVICE_ERROR_TOKEN_EXPIRED) ||
+			      g_error_matches (*error, E_OAUTH2_SERVICE_ERROR, E_OAUTH2_SERVICE_ERROR_REFRESH_FAILED))) {
 			(*error)->domain = EWS_CONNECTION_ERROR;
 			(*error)->code = EWS_CONNECTION_ERROR_AUTHENTICATION_FAILED;
 		}
diff --git a/src/Microsoft365/common/e-m365-connection.c b/src/Microsoft365/common/e-m365-connection.c
index d67cb752..5474090a 100644
--- a/src/Microsoft365/common/e-m365-connection.c
+++ b/src/Microsoft365/common/e-m365-connection.c
@@ -1574,8 +1574,8 @@ e_m365_connection_authenticate_sync (EM365Connection *cnc,
 		} else if (e_soup_session_get_ssl_error_details (E_SOUP_SESSION (cnc->priv->soup_session), out_certificate_pem, out_certificate_errors)) {
 			result = E_SOURCE_AUTHENTICATION_ERROR_SSL_FAILED;
 		} else if (g_error_matches (local_error, E_SOUP_SESSION_ERROR, SOUP_STATUS_UNAUTHORIZED) ||
-			   /* Returned by the OAuth2 service when the token cannot be refreshed */
-			   g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_CONNECTION_REFUSED)) {
+			   g_error_matches (local_error, E_OAUTH2_SERVICE_ERROR, E_OAUTH2_SERVICE_ERROR_TOKEN_EXPIRED) ||
+			   g_error_matches (local_error, E_OAUTH2_SERVICE_ERROR, E_OAUTH2_SERVICE_ERROR_REFRESH_FAILED)) {
 			LOCK (cnc);
 
 			if (cnc->priv->impersonate_user) {
-- 
2.53.0

